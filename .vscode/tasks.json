{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 编译当前文件（单文件）",
            "command": "D:/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lws2_32"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "只编译当前打开的 .cpp 文件（练习用）"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 编译目录下所有 cpp（项目用）",
            "command": "D:/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${fileDirname}\\*.cpp",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lws2_32"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "编译当前目录所有 .cpp 文件（需只有一个 main）"
        },
        {
            "type": "shell",
            "label": "TextPilot 构建 (CMake)",
            "command": "cmake -S \"${workspaceFolder}/TextPilot\" -B \"${workspaceFolder}/TextPilot/build\" && cmake --build \"${workspaceFolder}/TextPilot/build\"",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "用 CMake 构建 TextPilot 全项目（推荐）"
        }
    ]
}